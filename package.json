{
  "name": "garmin-connect-personal-api-js",
  "version": "1.0.1",
  "description": "Unofficial JavaScript client and CLI for the Garmin Connect Personal API: sleep, HRV, steps, stress, Body Battery, activities, and more",
  "license": "Apache-2.0",
  "author": "Ivan Ficko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DynamicsNinja/connect-personal-api-js.git"
  },
  "homepage": "https://github.com/DynamicsNinja/connect-personal-api-js#readme",
  "bugs": {
    "url": "https://github.com/DynamicsNinja/connect-personal-api-js/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./commands": {
      "types": "./types/commands.d.ts",
      "default": "./src/commands.js"
    }
  },
  "types": "./types/index.d.ts",
  "bin": {
    "gc-personal": "bin/gc-personal.js"
  },
  "files": [
    "bin",
    "src",
    "types",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.4"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "garmin",
    "garmin-connect",
    "personal-api",
    "fitness",
    "health",
    "sleep",
    "hrv",
    "heart-rate",
    "steps",
    "stress",
    "body-battery",
    "spo2",
    "activities",
    "fit",
    "wearables",
    "quantified-self",
    "api-client",
    "cli",
    "typescript"
  ]
}
